---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /tratamientos/<slug>/.
// Diseño «revista de lujo»: banda perla con migas y hero partido (antetítulo en oro, título serif fino, texto,
// duración y precio sobre filete de oro, botones de cita y WhatsApp; a la derecha la foto con marco interior o,
// sin foto, un aro de oro con su icono); banda clara con el `detalle` y, al lado, los datos y la caja de cita en
// grafito; fotos (`imagenes`) en banda perla y otros tratamientos de la misma lista en rejilla sin tarjetas.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: `/#${f.idSeccion}` },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const cita = seccion('cita') ? '/#cita' : site.boton_cabecera?.url || '/#contacto';
const textoCita = site.boton_cabecera?.texto || 'Pedir cita';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const duracion = f.datos.find((d) => d.clave === 'duracion')?.valor ?? '';
const datos = f.datos.filter((d) => d.clave !== 'precio' && d.clave !== 'duracion');
const otras = relacionadas(f, 4);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda--perla ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion">{f.titulo}</h1>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {(duracion || f.precio) && (
            <p class="ficha-chips">
              {duracion && <span class="ficha-duracion"><Icono nombre="reloj" tam={15} /> {duracion}</span>}
              {f.precio && <span class="ficha-precio">{f.precio}</span>}
            </p>
          )}
          <div class="ficha-botones">
            <a class="btn" href={cita}>{textoCita}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto marco">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true"><Icono nombre={f.icono || 'flor'} tam={72} /></div>
        )}
      </div>
    </div>
  </section>

  <section class="banda--clara ficha-seccion">
    <div class="contenedor ficha-cuerpo">
      <article class="ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio || duracion) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo">En pocas palabras</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd class="ficha-precio">{f.precio}</dd></div>}
              {duracion && <div><dt>Duración</dt><dd>{duracion}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-cita banda--oscura">
          <p class="ficha-cita-titulo">¿Hablamos de tu caso?</p>
          <p class="ficha-cita-texto">Te explicamos el tratamiento tras una valoración médica y sin compromiso.</p>
          <a class="btn" href={cita}>{textoCita}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda--perla ficha-seccion" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li class="marco"><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda--clara ficha-seccion">
      <div class="contenedor">
        <Titular alinear="partido" antetitulo={nombreSeccion} titulo={`Otros ${nombreSeccion.toLowerCase()}`} />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              {o.categoria && <p class="ficha-otra-cat">{o.categoria}</p>}
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p class="ficha-otra-texto">{o.texto}</p>}
              <p class="ficha-otra-pie">
                {o.precio ? <span class="ficha-precio">{o.precio}</span> : <span></span>}
                <span class="ficha-otra-ver" aria-hidden="true">Ver <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="ficha-todos"><a class="btn-sec" href={`/#${f.idSeccion}`}>Ver todos los {nombreSeccion.toLowerCase()}</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1.25rem, 3vw, 2.25rem) clamp(3.5rem, 7vw, 6rem); }
  .ficha-seccion { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .6rem; font-size: .68rem; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; }
  .migas li { display: inline-flex; align-items: center; gap: .6rem; min-width: 0; }
  .migas li + li::before { content: ""; width: 1.25rem; height: 1px; background: var(--linea-oro); }
  .migas a { color: var(--oro-texto); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; }
  .migas [aria-current] { opacity: .7; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2rem); align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.5rem, 1.6rem + 4vw, 4.6rem); overflow-wrap: anywhere; }
  .ficha-chips { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .75rem 1.5rem; margin-top: 1.75rem; padding-top: 1.1rem; border-top: 1px solid var(--linea-oro); max-width: 40rem; font-size: .9rem; }
  .ficha-duracion { display: inline-flex; align-items: center; gap: .5rem; }
  .ficha-precio { font-family: var(--fuente-titulos); font-size: 1.5rem; color: var(--oro-texto); }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-foto { aspect-ratio: 4 / 3; background: var(--perla-honda); }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 4 / 3; border: 1px solid var(--linea-oro); color: var(--oro-texto); }
  .ficha-cuerpo { display: grid; gap: 3.5rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.1rem; line-height: 1.75; }
  .ficha-detalle p + p { margin-top: 1.3rem; }
  .ficha-detalle p:first-child { font-family: var(--fuente-titulos); font-size: clamp(1.35rem, 1.1rem + 1vw, 1.75rem); line-height: 1.4; font-style: italic; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: 1.5rem; margin-bottom: .75rem; }
  .ficha-datos { border-top: 1px solid var(--linea-oro); padding-top: 1.5rem; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: .85rem 0; border-top: 1px solid var(--linea); }
  .ficha-datos dl > div:first-child { border-top: 0; }
  .ficha-datos dt { font-size: .68rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; opacity: .7; }
  .ficha-datos dd { text-align: right; min-width: 0; overflow-wrap: anywhere; }
  .ficha-cita { display: grid; gap: 1rem; padding: 2rem 1.5rem; justify-items: start; }
  .ficha-cita-titulo { font-family: var(--fuente-titulos); font-size: 1.75rem; line-height: 1.15; font-weight: 300; }
  .ficha-cita-texto { opacity: .8; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; color: var(--oro-claro); text-decoration: none; letter-spacing: .08em; }
  .ficha-galeria { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; background: var(--perla-honda); }
  .ficha-otras { display: grid; gap: 0; border-top: 1px solid var(--linea); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .5rem; padding: 1.75rem 0; border-bottom: 1px solid var(--linea); }
  .ficha-otra-cat { color: var(--oro-texto); font-size: .68rem; font-weight: 600; letter-spacing: .28em; text-transform: uppercase; }
  .ficha-otra h3 { font-size: clamp(1.5rem, 1.3rem + .8vw, 1.9rem); line-height: 1.1; overflow-wrap: anywhere; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 2px solid var(--c-primario); outline-offset: 2px; }
  .ficha-otra-texto { opacity: .75; font-size: .95rem; }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .75rem; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .4rem; color: var(--oro-texto); font-size: .68rem; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; }
  .ficha-otra:hover .ficha-otra-ver { text-decoration: underline; }
  .ficha-todos { margin-top: 2.5rem; }
  @media (min-width: 640px) { .ficha-otras { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2.5rem; } }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 5rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 6rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
    .ficha-otras { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 2rem; }
  }
</style>
