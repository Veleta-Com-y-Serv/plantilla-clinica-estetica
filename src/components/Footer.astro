---
// Pie grafito a todo el ancho con un filete de oro arriba y cuatro columnas: marca (nombre, eslogan y redes),
// menú, contacto y horario. «Web creada con NoExpertise» se muestra si site.yaml → marca_pie no es false.
import { site, tel, mapa, whatsapp } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string }
const { variante = 'grafito' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
---

<footer class={`pie pie--${variante}`}>
  <div class="contenedor pie-rejilla">
    <div>
      {site.logo ? <img src={site.logo} alt={site.nombre} class="pie-logo" width="200" height="56" loading="lazy" /> : <p class="pie-nombre">{site.nombre}</p>}
      {site.eslogan && <p class="pie-eslogan">{site.eslogan}</p>}
      {
        redes.length > 0 && (
          <ul class="pie-redes">
            {redes.map(([red, url]) => (
              <li>
                <a href={url} rel="noopener" target="_blank" aria-label={red}>
                  <Icono nombre={red} tam={18} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    {
      site.menu.length > 0 && (
        <nav aria-label="Menú del pie">
          <p class="pie-titulo">Menú</p>
          <ul class="pie-lista">
            {site.menu.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}
          </ul>
        </nav>
      )
    }
    {
      (c.direccion || c.telefono || c.email || c.whatsapp) && (
        <div>
          <p class="pie-titulo">Contacto</p>
          <ul class="pie-lista">
            {c.direccion && <li><a href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a></li>}
            {c.telefono && <li><a href={tel(c.telefono)}>{c.telefono}</a></li>}
            {c.whatsapp && <li><a href={whatsapp(c.whatsapp)} rel="noopener" target="_blank">WhatsApp {c.whatsapp}</a></li>}
            {c.email && <li><a href={`mailto:${c.email}`}>{c.email}</a></li>}
          </ul>
        </div>
      )
    }
    {
      c.horario && (
        <div>
          <p class="pie-titulo">Horario</p>
          <p class="opacity-80">{c.horario}</p>
        </div>
      )
    }
  </div>
  <div class="contenedor pie-legal">
    <span>© {anio} {site.nombre}</span>
    <a href="/aviso-legal">Aviso legal y privacidad</a>
    {
      site.marca_pie && (
        <span class="pie-noexpertise">
          Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
        </span>
      )
    }
  </div>
</footer>
