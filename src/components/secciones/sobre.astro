---
// La clínica: banda perla partida 50/50 con la foto (`imagen`) a sangre tocando el borde izquierdo de la ventana
// y, a la derecha, antetítulo, título, `declaracion` (frase grande en cursiva), párrafos de `texto`, `items`
// (icono, titulo, texto) en dos columnas separadas por filetes y `cta`. Sin foto, el texto ocupa la banda.
import { seccion, parrafos, valor } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const declaracion = valor(s?.declaracion);
const items = s ? s.items.filter((it) => it && it.titulo) : [];
---

{
  s && (
    <section id={Astro.props.id} class="banda--perla">
      <div class:list={['sobre-rejilla', { 'sobre-rejilla--sola': !s.imagen }]}>
        {s.imagen && (
          <div class="sobre-foto marco">
            <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={1600} class="h-full w-full object-cover" />
          </div>
        )}
        <div class:list={['mitad-texto', s.imagen ? 'mitad-texto--der' : 'contenedor']}>
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          {s.titulo && <h2 class="titulo-seccion">{s.titulo}</h2>}
          {declaracion && <p class="sobre-declaracion">{declaracion}</p>}
          {s.texto && (
            <div class="mt-7 max-w-2xl space-y-4 opacity-80">
              {parrafos(s.texto).map((p) => <p>{p}</p>)}
            </div>
          )}
          {items.length > 0 && (
            <ul class="sobre-items">
              {items.map((it) => (
                <li>
                  <span class="sobre-icono"><Icono nombre={it.icono} tam={20} /></span>
                  <span>
                    <span class="block font-semibold">{it.titulo}</span>
                    {it.texto && <span class="mt-1 block text-sm opacity-75">{it.texto}</span>}
                  </span>
                </li>
              ))}
            </ul>
          )}
          {s.cta?.url && <a class="btn-sec mt-10" href={s.cta.url}>{s.cta.texto}</a>}
        </div>
      </div>
    </section>
  )
}

<style>
  .sobre-rejilla { display: grid; }
  .sobre-foto { aspect-ratio: 4 / 3; background: var(--perla-honda); }
  .sobre-declaracion { margin-top: 2rem; padding-left: 1.5rem; border-left: 1px solid var(--c-primario); font-family: var(--fuente-titulos); font-style: italic; font-size: clamp(1.45rem, 1.1rem + 1.2vw, 2.1rem); line-height: 1.25; max-width: 34ch; }
  .sobre-items { margin-top: 2.75rem; display: grid; border-top: 1px solid var(--linea-oro); }
  .sobre-items li { display: flex; gap: 1rem; align-items: flex-start; padding-block: 1.25rem; border-bottom: 1px solid var(--linea); }
  .sobre-icono { color: var(--oro-texto); margin-top: .15rem; flex-shrink: 0; }
  @media (min-width: 640px) {
    .sobre-items { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; }
  }
  @media (min-width: 1024px) {
    .sobre-rejilla { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: 90svh; }
    .sobre-rejilla--sola { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .sobre-foto { aspect-ratio: auto; min-height: 100%; }
    .sobre-foto :global(img) { position: absolute; inset: 0; }
  }
</style>
