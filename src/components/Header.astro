---
// Cabecera «nácar»: fija arriba, a todo el ancho, blanca translúcida con un filete de oro.
// Nombre (o logo) a la izquierda, menú en mayúsculas espaciadas en el centro (escritorio ancho) y, a la derecha,
// teléfono (desde 1440 px) y botón de cabecera. Por debajo de 1280 px, menú plegable sin librerías (<details>).
// El aspecto está en src/styles/global.css (.cabecera--nacar).
import { site, tel } from '../data/site';
import type { Enlace } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string; cta?: Enlace | null }
const { variante = 'nacar', cta = null } = Astro.props;
const telefono = site.contacto.telefono;
---

<header class={`cabecera cabecera--${variante}`}>
  <div class="contenedor cab-fila">
    <a href="/" class="cab-marca" aria-label={`${site.nombre}, inicio`}>
      {site.logo ? <img src={site.logo} alt={site.nombre} class="cab-logo" width="200" height="56" /> : <span class="cab-nombre">{site.nombre}</span>}
    </a>
    {
      site.menu.length > 0 && (
        <nav class="cab-nav" aria-label="Menú principal">
          {site.menu.map((e) => <a href={e.url}>{e.texto}</a>)}
        </nav>
      )
    }
    <div class="cab-acciones">
      {
        telefono && (
          <a class="cab-telefono" href={tel(telefono)}>
            <Icono nombre="telefono" tam={15} />
            <span>{telefono}</span>
          </a>
        )
      }
      {cta && cta.url && <a href={cta.url} class="btn cab-cta">{cta.texto}</a>}
      {
        (site.menu.length > 0 || telefono) && (
          <details class="menu-movil">
            <summary aria-label="Menú">
              <span class="menu-movil-icono" aria-hidden="true" />
            </summary>
            <nav class="menu-movil-panel" aria-label="Menú">
              {site.menu.map((e) => <a href={e.url}>{e.texto}</a>)}
              {cta && cta.url && <a href={cta.url} class="btn">{cta.texto}</a>}
              {telefono && <a href={tel(telefono)}>{telefono}</a>}
            </nav>
          </details>
        )
      }
    </div>
  </div>
</header>
<script is:inline>
  document.querySelectorAll('.menu-movil a').forEach(function (a) {
    a.addEventListener('click', function () { a.closest('details').open = false; });
  });
</script>
